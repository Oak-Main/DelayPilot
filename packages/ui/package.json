{
  "name": "@delaypilot/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design tokens, accessible UI primitives, and composed patterns shared by the public site and the authenticated app.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./primitives.css": "./src/primitives/primitives.css"
  },
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "tokens:build": "node src/tokens/generate.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@delaypilot/contracts": "workspace:*",
    "@delaypilot/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
